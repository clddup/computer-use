{
  "name": "independent-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.14 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "package:macos": "node ../scripts/package-macos.mjs",
    "protocol:generate": "node ../scripts/generate-protocol.mjs",
    "protocol:check": "node ../scripts/generate-protocol.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:gui": "node ../scripts/windows-e2e.mjs",
    "test:gui:cold-start": "node ../scripts/windows-cold-start-e2e.mjs",
    "test:macos:bridge": "node ../scripts/macos-bridge-checks.mjs",
    "test:gui:macos": "node ../scripts/macos-e2e.mjs",
    "test:gui:macos:smoke": "node ../scripts/macos-e2e.mjs --fixture-smoke",
    "test:gui:macos:targeted": "node ../scripts/macos-targeted-e2e.mjs",
    "test:gui:macos:presentation": "node ../scripts/macos-presentation-checks.mjs",
    "test:gui:macos:shared-capture": "node ../scripts/macos-shared-capture-checks.mjs",
    "check": "pnpm build && pnpm protocol:check && pnpm typecheck && pnpm test",
    "mcp": "node packages/mcp/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "json-schema-to-typescript": "15.0.4",
    "tsdown": "0.23.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
